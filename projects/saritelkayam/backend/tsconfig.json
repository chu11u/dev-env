{
   "compilerOptions": {
     "target": "ES2017",
     "module": "ESNext",
     "moduleResolution": "bundler",
     "outDir": "./dist",
     "rootDir": ".",
     "strict": true,
     "esModuleInterop": true,
     "skipLibCheck": true,
     "forceConsistentCasingInFileNames": true,
     "declaration": true,
     "resolveJsonModule": true,
     "isolatedModules": true
   },
   "include": ["**/*.ts"],
   "exclude": ["node_modules", "dist", "generated"]
}
